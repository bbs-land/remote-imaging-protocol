#!/usr/bin/env bash
# Execute original RIPtel classic CHR glyph instructions in an isolated 32-bit routine probe.
# Requires an i386/amd64 Unix host and a C compiler with 32-bit runtime support.
# Exits nonzero on wrong artifact, build failure, or failed observation.
set -euo pipefail
ulimit -c 0
root="$(cd "$(dirname "$0")/.." && pwd)"
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Usage: run/riptel-chr-probe DLL FONT_DIRECTORY [SVG_OUTPUT] (CC may select a compiler with -m32 support)"
  exit 0
fi
if [[ $# -lt 2 || $# -gt 3 ]]; then
  echo "Supply DLL and original CHR font directory; see --help" >&2
  exit 2
fi
deno run --allow-read "$root/run/riptel-inspect" "$1" --chr-fonts "$2" --verify
probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/riptel-chr-probe.XXXXXX")"
trap 'rm -rf "$probe_dir"' EXIT
"${CC:-cc}" -m32 -O0 -Wall -Wextra -Werror -fno-pie -Wl,-no-pie "$root/run/lib/riptel-chr-probe.c" -o "$probe_dir/probe"
"$probe_dir/probe" "$@"
