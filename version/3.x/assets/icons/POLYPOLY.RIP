!|k01
!|S0409|!       Setup the fill color (blue)
!|c07|!         Set color to light gray
!|=00000003|!   Solid line 3 pixel wide
!|!
!|Y00000200
!|@1009RIP_POLY_POLYGON
!|!
!|c0E|!         Set color to yellow
!|!
!|<05\
041010701070701070\
03402060602060\
03602080404050\
04201K901K902K202K\
041A5A905A90801A80
